// All-pairs N-body gravity, ported from Scrawk/GPU-GEMS-NBody-Simulation (IntegrateBodies.compute, MIT),
// which is a Direct Compute port of the GPU Gems 3 chapter 31 CUDA code: each thread group loads a tile of
// positions into shared memory, every thread adds the pull of each body in the tile, then moves to the next tile
// (WRAP makes each group start at a different tile). Softened gravity: a += m_j * r / (|r|^2 + eps^2)^1.5.
// Integration as in the source: v += a dt, v *= damping, p += v dt.
// Changes:
//  - one thread per body over ALL bodies. The source divides the loop by q = 4 even though its multi-thread-per-body
//    path is switched off, so each body only sums a quarter of the others.
//  - the source scales by the mass of the body being updated (bj.w); here it is the mass of the other body.
//    With all masses equal (the source's setup) both give the same result.
//  - CentreOnly kernel for the comparison: each star feels only its own galaxy's centre, the two centres feel each other.
#pragma kernel CSMain
#pragma kernel CentreOnly

#define NUM_THREADS 64

float _SofteningSquared, _DeltaTime, _Damping;
uint _NumBodies, _CoreA, _CoreB;
float4 _GroupDim;
StructuredBuffer<float4> _ReadPos, _ReadVel;
RWStructuredBuffer<float4> _WritePos, _WriteVel;

groupshared float4 sharedPos[NUM_THREADS];

#define WRAP(x,m) (((x)<m)?(x):(x-m))

// other = the body that pulls, self = the body being updated
float3 bodyBodyInteraction(float3 ai, float4 other, float4 self)
{
    float3 r = other.xyz - self.xyz;
    float distSqr = dot(r, r) + _SofteningSquared;
    float distSixth = distSqr * distSqr * distSqr;
    float invDistCube = 1.0f / sqrt(distSixth);
    float s = other.w * invDistCube;
    return ai + r * s;
}

float3 computeBodyForce(float4 pos, uint3 groupID, uint3 threadID)
{
    float3 acc = 0;
    uint groups = (uint)_GroupDim.x;
    uint tile = 0;
    for (uint i = 0; i < _NumBodies; i += NUM_THREADS, tile++)
    {
        sharedPos[threadID.x] = _ReadPos[WRAP(groupID.x + tile, groups) * NUM_THREADS + threadID.x];
        GroupMemoryBarrierWithGroupSync();
        for (uint k = 0; k < NUM_THREADS; )
        {
            acc = bodyBodyInteraction(acc, sharedPos[k], pos); k += 1;
            acc = bodyBodyInteraction(acc, sharedPos[k], pos); k += 1;
            acc = bodyBodyInteraction(acc, sharedPos[k], pos); k += 1;
            acc = bodyBodyInteraction(acc, sharedPos[k], pos); k += 1;
        }
        GroupMemoryBarrierWithGroupSync();
    }
    return acc;
}

void Integrate(uint index, float4 pos, float4 vel, float3 force)
{
    vel.xyz += force * _DeltaTime;
    vel.xyz *= _Damping;
    pos.xyz += vel.xyz * _DeltaTime;
    _WritePos[index] = pos;
    _WriteVel[index] = vel;
}

[numthreads(NUM_THREADS, 1, 1)]
void CSMain(uint3 groupID : SV_GroupID, uint3 threadID : SV_GroupThreadID)
{
    uint index = groupID.x * NUM_THREADS + threadID.x;
    float4 pos = _ReadPos[index];
    float4 vel = _ReadVel[index];
    Integrate(index, pos, vel, computeBodyForce(pos, groupID, threadID));
}

[numthreads(NUM_THREADS, 1, 1)]
void CentreOnly(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    float4 pos = _ReadPos[index];
    float4 vel = _ReadVel[index];
    float4 ca = _ReadPos[_CoreA], cb = _ReadPos[_CoreB];
    float3 acc = 0;
    if (index == _CoreA) acc = bodyBodyInteraction(acc, cb, pos);
    else if (index == _CoreB) acc = bodyBodyInteraction(acc, ca, pos);
    else acc = bodyBodyInteraction(acc, index < _CoreB ? ca : cb, pos);
    Integrate(index, pos, vel, acc);
}
