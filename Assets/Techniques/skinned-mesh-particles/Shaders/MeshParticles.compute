// My particle system fed by the Smrvfx baker maps (PositionMap, VelocityMap, NormalMap).
// Emit: new particles take a random texel of the maps: position, the surface velocity times _Inherit, a small push
// along the normal. Update: drag, a little lift, a cheap swirl field, then integrate. Ring buffer, fixed count.
#pragma kernel Emit
#pragma kernel Step

RWStructuredBuffer<float4> _Pos;   // xyz, age
RWStructuredBuffer<float4> _Vel;   // xyz, life
Texture2D<float4> _PosMap, _VelMap, _NrmMap;
uint _Count, _Head, _EmitCount, _Frame, _MapW, _MapH;
float _Inherit, _Dt, _Time;

uint Hash(uint s)
{
    s ^= 2747636419u; s *= 2654435769u; s ^= s >> 16; s *= 2654435769u; s ^= s >> 16; s *= 2654435769u;
    return s;
}
float Rand(uint s) { return Hash(s) / 4294967295.0; }

[numthreads(64, 1, 1)]
void Emit(uint id : SV_DispatchThreadID)
{
    if (id >= _EmitCount) return;
    uint i = (_Head + id) % _Count;
    uint seed = id * 7919u + _Frame * 104729u;
    uint h = Hash(seed);
    uint2 tx = uint2(h % _MapW, (h / _MapW) % _MapH);
    float3 p = _PosMap[tx].xyz, v = _VelMap[tx].xyz, n = _NrmMap[tx].xyz;
    float3 jit = float3(Rand(seed + 1), Rand(seed + 2), Rand(seed + 3)) - 0.5;
    _Pos[i] = float4(p + n * 0.004, 0);
    _Vel[i] = float4(v * _Inherit + n * 0.12 + jit * 0.06, 1.1 + 0.9 * Rand(seed + 4));
}

[numthreads(256, 1, 1)]
void Step(uint id : SV_DispatchThreadID)
{
    if (id >= _Count) return;
    float4 P = _Pos[id], V = _Vel[id];
    if (P.w >= V.w) return;                       // dead until it is emitted again
    float3 p = P.xyz, v = V.xyz;
    float3 swirl = float3(sin(p.y * 5.1 + _Time * 1.3), sin(p.z * 4.3 + _Time * 1.1), sin(p.x * 4.7 + _Time * 0.9));
    v += (float3(0, 0.25, 0) + swirl * 0.35) * _Dt;
    v *= exp(-1.6 * _Dt);
    p += v * _Dt;
    _Pos[id] = float4(p, P.w + _Dt);
    _Vel[id] = float4(v, V.w);
}
