// Physarum transport network on the GPU.
// Ported from fogleman/physarum (pkg/physarum: model.go, grid.go, blur.go, config.go; MIT), a CPU Go version:
// per species a trail grid; each step (1) combine the grids through the attraction table, (2) every agent reads
// the combined grid at three sensors and turns by the source's direction() rule, then moves, (3) every agent
// deposits on its own species grid, (4) box blur radius 1, two passes, the last one scaled by the decay factor.
// Changed for the GPU: one thread per agent, deposits counted with atomics, sin/cos instead of lookup tables,
// grid wraps with modulo so it can be 1920 x 1080. _Sense 0 replaces the sensing rule by random turns (comparison).
#pragma kernel InitAgents
#pragma kernel InitData
#pragma kernel Combine
#pragma kernel Move
#pragma kernel Deposit
#pragma kernel BlurH
#pragma kernel BlurV
#pragma kernel Draw

struct Agent { float x, y, a; uint c; };
RWStructuredBuffer<Agent> agents;
RWStructuredBuffer<float> data, tmp, temp;
RWStructuredBuffer<uint> count;
StructuredBuffer<float4> cfg;   // per species: sensor angle, sensor distance, rotation angle, step distance
StructuredBuffer<float> tbl;    // attraction table, S x S
RWTexture2D<float4> Dest;
int _W, _H, _S, _N, _Per, _Sense, _R;
uint _Seed, _Step;
float _Deposit, _Scale, _Max;
float4 _Pal[3];

static const float TAU = 6.28318530718;

uint Hash(uint x) { x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16; return x; }
float Rand(uint a, uint b) { return (Hash(a ^ Hash(b)) & 0xffffffu) / 16777216.0; }
int Cell(float x, float y) { int i = ((int)(x + _W)) % _W; int j = ((int)(y + _H)) % _H; return j * _W + i; }

[numthreads(256, 1, 1)]
void InitAgents(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _N) return;
    Agent p;
    p.x = Rand(id.x * 3 + 0, _Seed) * _W;
    p.y = Rand(id.x * 3 + 1, _Seed) * _H;
    p.a = Rand(id.x * 3 + 2, _Seed) * TAU;
    p.c = min(id.x / (uint)_Per, (uint)(_S - 1));
    agents[id.x] = p;
}

[numthreads(256, 1, 1)]
void InitData(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _S * _W * _H) return;
    data[id.x] = Rand(id.x, _Seed ^ 0x9e3779b9u); // source: each grid starts with random 0..1
    count[id.x] = 0;
}

[numthreads(256, 1, 1)]
void Combine(uint3 id : SV_DispatchThreadID)
{
    int wh = _W * _H;
    if ((int)id.x >= wh) return;
    for (int c = 0; c < _S; c++)
    {
        float v = 0;
        for (int i = 0; i < _S; i++) v += data[i * wh + id.x] * tbl[c * _S + i];
        temp[c * wh + id.x] = v;
    }
}

[numthreads(256, 1, 1)]
void Move(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _N) return;
    Agent p = agents[id.x];
    int base = (int)p.c * _W * _H;
    float4 k = cfg[p.c];
    float sa = k.x, sd = k.y, ra = k.z, st = k.w;
    float C = temp[base + Cell(p.x + cos(p.a) * sd, p.y + sin(p.a) * sd)];
    float L = temp[base + Cell(p.x + cos(p.a - sa) * sd, p.y + sin(p.a - sa) * sd)];
    float R = temp[base + Cell(p.x + cos(p.a + sa) * sd, p.y + sin(p.a + sa) * sd)];
    uint h = Hash(id.x ^ Hash(_Step * 747796405u + _Seed));
    float d;
    if (_Sense == 0) d = (float)(h % 3u) - 1.0;      // comparison: random turn left, none or right
    else if (C > L && C > R) d = 0;
    else if (C < L && C < R) d = (h & 1u) ? 1.0 : -1.0;
    else if (L < R) d = 1;
    else if (R < L) d = -1;
    else d = 0;
    p.a += ra * d; p.a -= TAU * floor(p.a / TAU);
    p.x += cos(p.a) * st; p.x -= _W * floor(p.x / _W);
    p.y += sin(p.a) * st; p.y -= _H * floor(p.y / _H);
    agents[id.x] = p;
    InterlockedAdd(count[base + Cell(p.x, p.y)], 1u);
}

[numthreads(256, 1, 1)]
void Deposit(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _S * _W * _H) return;
    data[id.x] += count[id.x] * _Deposit;
    count[id.x] = 0;
}

[numthreads(256, 1, 1)]
void BlurH(uint3 id : SV_DispatchThreadID)
{
    int wh = _W * _H;
    if ((int)id.x >= _S * wh) return;
    int s = id.x / wh, cell = id.x % wh, x = cell % _W, y = cell / _W;
    float v = 0;
    for (int o = -_R; o <= _R; o++) v += data[s * wh + y * _W + (x + o + _W) % _W];
    tmp[id.x] = v / (2 * _R + 1);
}

[numthreads(256, 1, 1)]
void BlurV(uint3 id : SV_DispatchThreadID)
{
    int wh = _W * _H;
    if ((int)id.x >= _S * wh) return;
    int s = id.x / wh, cell = id.x % wh, x = cell % _W, y = cell / _W;
    float v = 0;
    for (int o = -_R; o <= _R; o++) v += tmp[s * wh + ((y + o + _H) % _H) * _W + x];
    data[id.x] = v / (2 * _R + 1) * _Scale;
}

[numthreads(8, 8, 1)]
void Draw(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _W || (int)id.y >= _H) return;
    int wh = _W * _H, cell = id.y * _W + id.x;
    float3 c = 0;
    for (int s = 0; s < _S; s++) c += _Pal[s].rgb * pow(saturate(data[s * wh + cell] / _Max), 1.0 / 2.2); // source Image(): t^(1/2.2)
    Dest[id.xy] = float4(pow(saturate(c), 2.2), 1); // sRGB-space sum, shown through the linear pipeline
}
