# Unity caches and per-machine files
/Library/
/Temp/
/Obj/
/Logs/
/UserSettings/
/Build/
/Builds/
*.csproj
*.sln
*.slnx
.vs/
.vscode/
.idea/
.DS_Store

# Renders from tools/capture.sh
/Recordings/
*.mp4

# Scenes, materials and textures that each BuildScene.cs generates
/Assets/Techniques/*/Main.unity
/Assets/Techniques/**/*.mat
/Assets/Techniques/**/*.asset
/Assets/Techniques/**/*.renderTexture
/Assets/Techniques/**/*.meta
/Assets/Techniques.meta

# Your own character model (see README): never committed
/Assets/Shared/Character/Model/
/Assets/Shared/Character/Model.meta
